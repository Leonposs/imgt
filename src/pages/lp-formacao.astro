---
import LpLayout from '../layouts/LpLayout.astro';
---

<LpLayout
  title="Formação em Gestalt-Terapia: Fundamentos e Técnicas — IMGT"
  description="Curso de Formação em Gestalt-Terapia com certificado de extensão universitária reconhecido pelo MEC. Instituto Mineiro de Gestalt-Terapia."
>
  <style is:global>
    /* Page-specific palette — LP Formação Completa */
        body {
          --page-dark: #F5F4F0;
          --page-mid: #0A6F99;
          --page-accent: #00C3FF;
          --page-accent-soft: #00A8DB;
    
          /* Glass tokens — DARK MODE */
          --glass-light: rgba(19, 40, 71, 0.55);
          --glass-light-border: rgba(0, 195, 255, 0.15);
          --glass-dark: rgba(0, 0, 0, 0.2);
          --glass-dark-border: rgba(0, 195, 255, 0.12);
          --glass-placeholder: rgba(19, 40, 71, 0.65);
          --glass-blur: 16px;
    
          /* Ambient shadow — deeper for dark bg */
          --shadow-ambient: 0 4px 24px rgba(0, 0, 0, 0.15), 0 12px 48px rgba(0, 0, 0, 0.10);
          --shadow-elevated: 0 8px 32px rgba(0, 0, 0, 0.20), 0 24px 64px rgba(0, 0, 0, 0.12);
          --shadow-float: 0 12px 40px rgba(0, 0, 0, 0.25), 0 32px 80px rgba(0, 0, 0, 0.15);
        }
    .hero-bg { background-image: url('/imagens/formacao-gestalt-terapia-instituto-mineiro-imgt.webp'); }
    /* === Per-page surface tokens (injected) === */
    body {
      --color-bg: #0B203F;
      --color-bg-elevated: #19365A;
      --color-bg-dark: #071933;
      --color-text-inverted: #0B203F;
    }
    .hero-bg { background-image: url('/imagens/formacao-gestalt-terapia-instituto-mineiro-imgt.webp'); }
    /* === End per-page surface tokens === */
    /* === Per-page surface tokens (injected) === */
    body {
      --color-bg: #0B203F;
      --color-bg-elevated: #19365A;
      --color-bg-dark: #071933;
      --color-text-inverted: #0B203F;
    }
    .hero-bg { background-image: url('/imagens/formacao-gestalt-terapia-instituto-mineiro-imgt.webp'); }
    body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
    repeating-linear-gradient(
    0deg,
    rgba(255, 255, 255, 0.04) 0px,
    rgba(255, 255, 255, 0.04) 1px,
    transparent 1px,
    transparent 80px
    ),
    repeating-linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.04) 0px,
    rgba(255, 255, 255, 0.04) 1px,
    transparent 1px,
    transparent 80px
    ),
    radial-gradient(
    ellipse at 30% 20%,
    rgba(0, 195, 255, 0.10) 0%,
    transparent 55%
    ),
    radial-gradient(
    ellipse at 70% 80%,
    rgba(0, 195, 255, 0.08) 0%,
    transparent 50%
    ),
    radial-gradient(
    ellipse at 50% 50%,
    rgba(0, 195, 255, 0.05) 0%,
    transparent 60%
    );
    will-change: transform;
    }
    /* === End per-page surface tokens === */
  </style>

  <!-- SVG SYMBOLS -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none;">
      <symbol id="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></symbol>
      <!-- Destaque icons -->
      <symbol id="icon-cert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></symbol>
      <symbol id="icon-infinity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4z"/></symbol>
      <symbol id="icon-bot" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></symbol>
      <symbol id="icon-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></symbol>
      <!-- Como funciona icons -->
      <symbol id="icon-play-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></symbol>
      <symbol id="icon-video" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></symbol>
      <symbol id="icon-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M8 7h6"/><path d="M8 11h8"/></symbol>
      <symbol id="icon-layout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></symbol>
      <symbol id="icon-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
      <symbol id="icon-award" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></symbol>
      <!-- FAQ icon -->
      <symbol id="icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></symbol>
      <!-- Play icon -->
      <symbol id="icon-play" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></symbol>
    </svg>
  
    <!-- GRADIENT MESH -->
    <div class="gradient-mesh" aria-hidden="true">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="glow glow-3"></div>
    </div>
  
    <!-- CUSTOM CURSOR -->
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
  
    <!-- 01. HERO -->
    <section class="hero scroll-section">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="morph-blob morph-blob--stroke" style="width:320px;height:320px;top:5%;left:1%;" aria-hidden="true">
        <svg viewBox="-100 -100 200 200" xmlns="http://www.w3.org/2000/svg">
          <path d="M40,-62C53,-55,65,-45,73,-32C81,-19,85,-3,82,11C79,25,69,38,57,48C45,58,31,66,15,69C-1,72,-19,70,-34,63C-49,56,-61,44,-68,29C-75,14,-77,-3,-72,-19C-67,-35,-55,-49,-42,-58C-29,-67,-14,-71,1,-72C16,-73,32,-70,40,-62Z"
            data-morph="M45,-58C56,-49,63,-35,67,-20C71,-5,72,11,66,25C60,39,47,51,33,58C19,65,4,67,-12,65C-28,63,-45,57,-56,45C-67,33,-72,15,-70,-2C-68,-19,-59,-35,-47,-47C-35,-59,-20,-67,-4,-68C12,-69,34,-67,45,-58Z" />
        </svg>
      </div>
      <div class="morph-blob morph-blob--fill" style="width:220px;height:220px;bottom:12%;right:5%;" aria-hidden="true">
        <svg viewBox="-100 -100 200 200" xmlns="http://www.w3.org/2000/svg">
          <path d="M38,-52C50,-44,60,-33,65,-19C70,-5,70,11,64,25C58,39,46,51,32,57C18,63,2,63,-14,60C-30,57,-46,51,-55,39C-64,27,-66,9,-63,-8C-60,-25,-52,-41,-40,-51C-28,-61,-14,-65,1,-65C16,-65,32,-60,38,-52Z"
            data-morph="M42,-56C54,-46,62,-32,66,-17C70,-2,70,14,63,28C56,42,42,54,27,59C12,64,-4,62,-19,57C-34,52,-48,44,-57,32C-66,20,-70,4,-67,-11C-64,-26,-54,-40,-42,-50C-30,-60,-15,-66,0,-66C15,-66,30,-62,42,-56Z" />
        </svg>
      </div>
  
      <div class="container">
        <div class="hero-content">
          <span class="hero-tag hero-anim">Formação Profissional</span>
          <h1 class="hero-anim">Formação em <em>Gestalt-Terapia</em></h1>
          <p class="hero-subtitle hero-anim">Fundamentos e Técnicas</p>
          <p class="hero-lead hero-anim">Domine as bases teóricas e as técnicas de intervenção clínica da Gestalt-Terapia — com certificado de extensão universitária reconhecido pelo MEC.</p>
          <div class="hero-actions hero-anim">
            <a href="#" class="btn-primary magnetic" data-strength="0.3">Quero me matricular</a>
            <a href="#conteudo" class="btn-secondary magnetic" data-strength="0.2">Ver o conteúdo programático</a>
          </div>
        </div>
      </div>
    </section>
  
    <!-- 02. BARRA DE DESTAQUES — 4 cards -->
    <section class="destaques scroll-section">
      <div class="container">
        <div class="destaques-grid">
          <div class="destaque-card tilt-card" data-anim="scale-up" data-delay="1">
            <div class="card-shine"></div>
            <div class="destaque-card-icon">
              <svg><use href="#icon-cert"/></svg>
            </div>
            <h3>Certificado MEC</h3>
            <p>Extensão universitária com reconhecimento oficial — válido para currículo, graduação, pós e concursos.</p>
          </div>
          <div class="destaque-card tilt-card" data-anim="scale-up" data-delay="2">
            <div class="card-shine"></div>
            <div class="destaque-card-icon">
              <svg><use href="#icon-infinity"/></svg>
            </div>
            <h3>Formato Assinatura</h3>
            <p>Acesso contínuo à formação + todos os minicursos do IMGT, atuais e futuros.</p>
          </div>
          <div class="destaque-card tilt-card" data-anim="scale-up" data-delay="3">
            <div class="card-shine"></div>
            <div class="destaque-card-icon">
              <svg><use href="#icon-bot"/></svg>
            </div>
            <h3>Tutor IA 24h</h3>
            <p><strong>Fritz</strong>, seu professor particular disponível a qualquer hora para dúvidas, resumos e mapas mentais.</p>
          </div>
          <div class="destaque-card tilt-card" data-anim="scale-up" data-delay="4">
            <div class="card-shine"></div>
            <div class="destaque-card-icon">
              <svg><use href="#icon-clock"/></svg>
            </div>
            <h3>+130h de conteúdo</h3>
            <p>Aulas gravadas, encontros ao vivo e minicursos complementares.</p>
          </div>
        </div>
      </div>
    </section>
  
    <!-- 03. PARA QUEM É ESTE CURSO -->
    <section class="para-quem scroll-section">
      <div class="container">
        <span class="section-label" data-anim="fade-up" data-scramble>Público-alvo</span>
        <h2 data-letter-stagger>Para quem é este curso?</h2>
        <p class="para-quem-text" data-anim="fade-up" data-delay="2">Embora seja mais procurado por <strong>psicólogos e estudantes de Psicologia</strong>, o curso está aberto a pessoas de diferentes formações. A Gestalt-Terapia proporciona esclarecimentos sobre os processos emocionais e relacionais que vivemos, além de estimular uma reflexão aprofundada sobre a forma como nos colocamos no mundo.</p>
      </div>
    </section>
  
    <!-- 04. O QUE É GESTALT-TERAPIA -->
    <section class="gestalt-intro scroll-section">
      <div class="container">
        <div class="gestalt-intro-text">
          <span class="section-label" data-anim="fade-up" data-scramble>A abordagem</span>
          <h2 data-letter-stagger>O que é Gestalt-Terapia?</h2>
          <div class="section-divider" data-anim="clip-left" data-delay="2"></div>
          <p data-anim="fade-up" data-delay="2">Uma modalidade de psicoterapia fundamentada na Fenomenologia, no Existencialismo e no Humanismo, que busca facilitar uma compreensão mais profunda do sujeito sobre si mesmo e suas relações — promovendo maior abertura existencial e capacidade de enfrentamento dos desafios da vida.</p>
          <a href="#" class="btn-primary magnetic" data-anim="fade-up" data-delay="3" data-strength="0.3">Quero me matricular</a>
        </div>
        <div class="gestalt-intro-visual">
          <div class="img-placeholder" data-anim="clip-up" style="aspect-ratio: 4/3;" data-role="sobre-professor">
            <span>ambiente-instituto &middot; 4:3</span>
          </div>
        </div>
      </div>
    </section>
  
    <!-- 05. FRITZ — TUTOR IA -->
    <section class="fritz-section scroll-section">
      <div class="container">
        <div class="fritz-icon" data-anim="scale-up">
          <svg><use href="#icon-bot"/></svg>
        </div>
        <span class="section-label" data-anim="fade-up" data-scramble>Inovação exclusiva</span>
        <h2 data-letter-stagger>Conheça o Fritz: seu tutor de IA, disponível 24/7</h2>
        <p class="fritz-text" data-anim="fade-up" data-delay="2">Uma inovação exclusiva do IMGT. O Fritz funciona como um verdadeiro professor particular: responde dúvidas sobre o conteúdo, cria resumos, esquemas e mapas mentais, e orienta a organização dos seus estudos.</p>
  
        <!-- Imageholder: exemplo de pergunta e resposta com o Fritz -->
        <figure class="fritz-example" data-anim="fade-up" data-delay="3" style="margin:2.5rem auto 0;max-width:720px;width:100%;border:1px dashed rgba(255,255,255,0.30);border-radius:18px;background:rgba(255,255,255,0.04);aspect-ratio:16/10;display:flex;align-items:center;justify-content:center;">
          <figcaption style="text-align:center;color:rgba(255,255,255,0.55);font-size:0.85rem;letter-spacing:0.18em;text-transform:uppercase;">Exemplo de pergunta e resposta · imagem em breve</figcaption>
        </figure>
  
        <div class="fritz-callout" data-anim="scale-up" data-delay="4">
          <p>Com o Fritz, você nunca está sozinho no aprendizado.</p>
        </div>
      </div>
    </section>
  
    <!-- 06. MARQUEE -->
    <section class="marquee-section">
      <div class="marquee-track">
        <span class="marquee-item">Gestalt-Terapia</span>
        <span class="marquee-item">Fenomenologia</span>
        <span class="marquee-item">Existencialismo</span>
        <span class="marquee-item">Humanismo</span>
        <span class="marquee-item">Ciclo do Contato</span>
        <span class="marquee-item">Teoria do Self</span>
        <span class="marquee-item">Awareness</span>
        <span class="marquee-item">Relação Dialógica</span>
        <span class="marquee-item">Aqui-agora</span>
        <span class="marquee-item">Gestalt-Terapia</span>
        <span class="marquee-item">Fenomenologia</span>
        <span class="marquee-item">Existencialismo</span>
        <span class="marquee-item">Humanismo</span>
        <span class="marquee-item">Ciclo do Contato</span>
        <span class="marquee-item">Teoria do Self</span>
        <span class="marquee-item">Awareness</span>
        <span class="marquee-item">Relação Dialógica</span>
        <span class="marquee-item">Aqui-agora</span>
      </div>
    </section>
  
    <!-- 07. CONTEÚDO PROGRAMÁTICO -->
    <section id="conteudo" class="conteudo scroll-section">
      <div class="logo-adornment" aria-hidden="true"></div>
      <div class="container">
        <span class="section-label" data-anim="fade-up" data-scramble>Programa do curso</span>
        <h2 data-letter-stagger>Conteúdo do Curso</h2>
  
        <div class="modulos-grid">
          <div class="modulo-card tilt-card" data-anim="fade-up" data-delay="1">
            <div class="card-shine"></div>
            <div class="modulo-number">I</div>
            <h3>Fundamentos filosóficos e teóricos</h3>
            <ul class="modulo-list">
              <li>Existencialismo</li>
              <li>Humanismo</li>
              <li>Fenomenologia</li>
              <li>Psicologia da Gestalt</li>
              <li>Teoria Organísmica</li>
              <li>Teoria de Campo</li>
            </ul>
          </div>
          <div class="modulo-card tilt-card" data-anim="fade-up" data-delay="2">
            <div class="card-shine"></div>
            <div class="modulo-number">II</div>
            <h3>Fundamentos psicológicos</h3>
            <ul class="modulo-list">
              <li>Ciclo do Contato</li>
              <li>Teoria do Self</li>
              <li>Neurose e saúde</li>
              <li>Mecanismos de defesa</li>
            </ul>
          </div>
          <div class="modulo-card tilt-card" data-anim="fade-up" data-delay="3">
            <div class="card-shine"></div>
            <div class="modulo-number">III</div>
            <h3>Teoria psicológica e psicoterapêutica</h3>
            <ul class="modulo-list">
              <li>Objetivo psicoterapêutico, awareness e insights</li>
              <li>Relação psicoterapêutica dialógica e aqui-agora</li>
              <li>Processo psicoterapêutico</li>
              <li>Construção da relação</li>
              <li>Demanda e contrato</li>
              <li>Estratégias e técnicas</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  
    <!-- 08. COMO FUNCIONA -->
    <section class="como-funciona scroll-section">
      <div class="como-funciona-bg" aria-hidden="true"></div>
      <div class="como-funciona-overlay" aria-hidden="true"></div>
      <div class="deco-circle-bg" aria-hidden="true"></div>
      <canvas class="particle-canvas" aria-hidden="true"></canvas>
  
      <div class="container">
        <span class="section-label" data-anim="fade-up" data-scramble>Como funciona</span>
        <h2 data-letter-stagger>Como funciona a formação</h2>
  
        <div class="como-funciona-grid">
          <div class="etapa-card tilt-card" data-anim="fade-up" data-delay="1">
            <div class="card-shine"></div>
            <div class="etapa-number">01</div>
            <h3>Estude no seu ritmo</h3>
            <p>Aulas gravadas para assistir e rever quantas vezes quiser, no computador, celular ou TV (app Hotmart).</p>
          </div>
          <div class="etapa-card tilt-card" data-anim="fade-up" data-delay="2">
            <div class="card-shine"></div>
            <div class="etapa-number">02</div>
            <h3>Encontros ao vivo</h3>
            <p>10h de aulas ao vivo com o professor — encontros de 2h30 cada.</p>
          </div>
          <div class="etapa-card tilt-card" data-anim="fade-up" data-delay="3">
            <div class="card-shine"></div>
            <div class="etapa-number">03</div>
            <h3>Material de apoio</h3>
            <p>Referências bibliográficas completas e material complementar em cada módulo.</p>
          </div>
          <div class="etapa-card tilt-card" data-anim="fade-up" data-delay="4">
            <div class="card-shine"></div>
            <div class="etapa-number">04</div>
            <h3>Área de membros exclusiva</h3>
            <p>Acesso a todos os módulos, materiais e informações em um só lugar.</p>
          </div>
          <div class="etapa-card tilt-card" data-anim="fade-up" data-delay="5">
            <div class="card-shine"></div>
            <div class="etapa-number">05</div>
            <h3>Comunidade no WhatsApp</h3>
            <p>Grupo exclusivo para interação entre alunos e professor.</p>
          </div>
          <div class="etapa-card tilt-card" data-anim="fade-up" data-delay="6">
            <div class="card-shine"></div>
            <div class="etapa-number">06</div>
            <h3>Certificado MEC</h3>
            <p>Certificado de extensão universitária reconhecido pelo MEC ao concluir a carga horária.</p>
          </div>
        </div>
      </div>
    </section>
  
    <!-- 09. BARRA DE NÚMEROS -->
    <section class="stats-bar scroll-section">
      <div class="stats-progress" aria-hidden="true"></div>
      <canvas class="particle-canvas" aria-hidden="true"></canvas>
      <div class="container">
        <div class="stat-item" data-anim="fade-up">
          <div class="stat-number"><span data-target="100" data-suffix="h">0</span></div>
          <div class="stat-label">De aulas gravadas</div>
        </div>
        <div class="stat-item" data-anim="fade-up" data-delay="1">
          <div class="stat-number"><span data-target="10" data-suffix="h">0</span></div>
          <div class="stat-label">De encontros ao vivo</div>
        </div>
        <div class="stat-item" data-anim="fade-up" data-delay="2">
          <div class="stat-number"><span data-target="20" data-prefix="+" data-suffix="h">0</span></div>
          <div class="stat-label">Em minicursos inclusos</div>
        </div>
        <div class="stat-item" data-anim="fade-up" data-delay="3">
          <div class="stat-number"><span data-target="130" data-prefix="+" data-suffix="h">0</span></div>
          <div class="stat-label">De conteúdo total</div>
        </div>
      </div>
    </section>
  
    <!-- 10. PROFESSOR -->
    <section class="sobre-professor scroll-section">
      <div class="container">
        <div class="professor-image" data-anim="slide-left">
          <div class="img-placeholder" data-role="sobre-professor" style="aspect-ratio: 1/1;">
            <img src="/imagens/retrato-marcelo-gomes-04.webp" alt="Marcelo Gomes" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;border-radius:inherit;">
            <div class="professor-logo-watermark"><img src="/Gbrand_assets/gestaltlogo.svg" alt=""></div>
          </div>
        </div>
        <div class="professor-text">
          <span class="section-label" data-anim="fade-up" data-scramble>Conheça o professor</span>
          <h2 data-letter-stagger>Quem vai te guiar nessa formação</h2>
          <div class="professor-name-sub" data-anim="fade-up" data-delay="1">Marcelo Gomes — CRP 04/23858</div>
          <div class="section-divider" data-anim="clip-left" data-delay="2"></div>
